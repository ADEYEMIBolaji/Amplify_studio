# Supabase project (https://app.supabase.com)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=

# Frontend (Next.js) — public, exposed to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend (FastAPI)
ENV=development
# Local dev default: SQLite. Point at Supabase Postgres in staging/prod —
# use the SESSION pooler (port 5432), not the Transaction pooler (6543):
# this backend holds long-lived connections, and the Transaction pooler's
# PgBouncer mode breaks asyncpg's prepared statements outright
# (DuplicatePreparedStatementError), even with statement_cache_size=0.
# postgresql+asyncpg://postgres.<project-ref>:<password>@<host>:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./dev.db
CORS_ORIGINS=["http://localhost:3000"]

# D-03 (transcription) / D-04 (LLM) — unset locally; FakeTranscriptionProvider
# and FakeLLMProvider are used until a provider is chosen (see CLAUDE.md).
TRANSCRIPTION_PROVIDER=fake
LLM_PROVIDER=fake

# D-06 — reminder channel; logs to console in development.
REMINDER_PROVIDER=console
REMINDER_LEAD_MINUTES=30
FRONTEND_BASE_URL=http://localhost:3000

# Media processing — "fake" copies files through unchanged (no ffmpeg on this
# machine); set to "ffmpeg" only where ffmpeg/ffprobe are actually on PATH
# (the worker container).
VIDEO_PROCESSOR=fake

# Private media storage (local filesystem substitute for Supabase Storage).
STORAGE_ROOT=./.storage
MEDIA_SIGNING_SECRET=dev-signing-secret-change-me
PUBLIC_API_BASE_URL=http://localhost:8000
SIGNED_URL_EXPIRY_SECONDS=900

MAX_UPLOAD_BYTES=524288000
MAX_UPLOAD_DURATION_SECONDS=300
